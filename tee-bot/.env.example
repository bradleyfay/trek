# Copy this file to .env (never commit .env to git)

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TO_NUMBER=+15557654321

# ── Member credentials ────────────────────────────────────────────────────────
# One pair per member; the prefix must match env_prefix in config.yaml

BRAD_USERNAME=brad@example.com
BRAD_PASSWORD=your_password_here

# JANE_USERNAME=jane@example.com
# JANE_PASSWORD=her_password_here
