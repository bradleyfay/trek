# Copy this file to .env (never commit .env to git)

# ── Twilio (twilio.com/console) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567   # your Twilio phone number
TWILIO_TO_NUMBER=+15557654321     # your personal cell number

# ── Club portal credentials ────────────────────────────────────────────────────
CLUB_USERNAME=your_email@example.com
CLUB_PASSWORD=your_password_here

# ── Optional ───────────────────────────────────────────────────────────────────
# Set to "false" to run with a visible browser window (useful for debugging selectors)
HEADLESS=true
